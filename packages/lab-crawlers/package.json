{
  "name": "@labmind/lab-crawlers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint lab-crawlers'",
    "smoke:dnkom": "pnpm build && node dist/scripts/smoke-dnkom.js",
    "smoke:gemotest": "pnpm build && node dist/scripts/smoke-gemotest.js",
    "test:dnkom-fixtures": "pnpm build && node dist/scripts/test-dnkom-fixtures.js",
    "test:gemotest-fixtures": "pnpm build && node dist/scripts/test-gemotest-fixtures.js",
    "sync:dnkom": "pnpm build && node dist/scripts/sync-dnkom.js",
    "sync:gemotest": "pnpm build && node dist/scripts/sync-gemotest.js",
    "crawler:run": "pnpm build && node dist/scripts/crawler-run.js",
    "invitro:probe": "pnpm build && node dist/scripts/invitro-probe.js",
    "compare:db": "pnpm build && node dist/scripts/compare-db.js",
    "compare:matrix": "pnpm build && node dist/scripts/compare-matrix.js",
    "compare:market": "pnpm build && node dist/scripts/compare-market.js",
    "match:db": "pnpm build && node dist/scripts/match-db.js",
    "match:manual": "pnpm build && node dist/scripts/match-manual.js",
    "cheapest:basket": "pnpm build && node dist/scripts/cheapest-basket.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "playwright": "^1.51.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
